{
  "name": "terra-dominion",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Terra Dominion - an offline 3D grand-strategy / RTS of a living Earth.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "node scripts/run-tests.mjs",
    "test:sim": "node scripts/run-sim-smoke.mjs",
    "data:countries": "node scripts/build-country-data.mjs"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
